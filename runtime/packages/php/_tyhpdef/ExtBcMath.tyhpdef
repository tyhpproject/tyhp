 */
function bcsqrt(string $num, ?int $scale = null): string;
/**
 * `bccomp`
 *
 * @param string $num1
 * @param string $num2
 * @param int $scale
 * @return int
 */
function bccomp(string $num1, string $num2, ?int $scale = null): int;
/**
