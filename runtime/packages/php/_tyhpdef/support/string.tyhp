//     /**
//      * Return information about characters used in a string.
//      *
//      * Counts the number of occurrences of every byte-value (0..255) in this string
//      * and returns the result according to `$mode`.
//      *
//      * Mode values:
//      * - `0` — an array with the byte-value as key and the frequency of every byte as value
//      * - `1` — same as `0` but only byte-values with a frequency greater than zero are listed
//      * - `2` — same as `0` but only byte-values with a frequency equal to zero are listed
//      * - `3` — a string containing all unique characters used
//      * - `4` — a string containing all characters not used
//      *
//      * @param string $s The string this method is called on.
//      * @param int $mode See description above. Defaults to `0`.
//      * @return array|string Depending on `$mode`, either an array of counts or a string of characters.
//      *
//      * @see https://www.php.net/manual/function.count-chars.php
//      */
//     #[\Tyhp\Optimize\Inline]
//     function countChars(extends string $s, int $mode = 0): array|string
//     {
//         return \count_chars($s, $mode);
//     }

