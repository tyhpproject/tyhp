//     /**
//      * Split a string by a string.
//      *
//      * Returns an array of strings, each of which is a substring of this string
//      * formed by splitting it on boundaries formed by `$separator`.
//      *
//      * Adapted parameter order: the extended string is the subject (haystack). In PHP,
//      * `explode($separator, $string, $limit)` takes the separator first; here `$s` is
//      * the string being split and `$separator` is passed as the next argument.
//      *
//      * @param string $s The string this method is called on (the string to split).
//      * @param string $separator The boundary string.
//      * @param int $limit If `$limit` is positive, the returned array will contain a maximum
//      *                   of `$limit` elements with the last element containing the rest of the string.
//      *                   If negative, all components except the last `-$limit` are returned.
//      *                   If zero, it is treated as `1`. Defaults to `PHP_INT_MAX`.
//      * @return array An array of strings.
//      *
//      * @see https://www.php.net/manual/function.explode.php
//      */
//     #[\Tyhp\Optimize\Inline]
