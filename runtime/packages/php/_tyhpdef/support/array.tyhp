//     // Adapted parameter order: array is not the first PHP parameter
//     /**
//      * Searches the array for a given value and returns the first corresponding key
//      * if successful.
//      *
//      * Adapted parameter order: the extended array is the haystack. In PHP,
//      * `array_search($needle, $haystack, $strict)` takes the needle first; here `$a`
//      * is the haystack and `$needle` follows.
//      *
//      * @param array $a The array this method is called on (haystack).
//      * @param mixed $needle The searched value.
//      * @param bool $strict If `true`, also checks the types of `$needle` in `$a`.
//      *                     Defaults to `false`.
//      * @return string|int|false The key for `$needle` if it is found in `$a`, or
//      *                          `false` otherwise.
//      *
//      * @see https://www.php.net/manual/function.array-search.php
//      */
//     #[\Tyhp\Optimize\Inline]
