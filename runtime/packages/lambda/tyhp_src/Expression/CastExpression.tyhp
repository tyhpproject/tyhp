<?tyhp

namespace Tyhp\Expression;

final class CastExpression extends ExpressionNode {
    public function __construct(
        public readonly string $targetType,
        public readonly ExpressionNode $operand,
    ) {
        parent::__construct($targetType, 'cast');
    }

    public function accept(ExpressionVisitor $visitor): mixed {
        return $visitor->visitCast($this);
    }
}
