<?tyhp

namespace Tyhp;

/** Return shape for {@see PropertyAccessorDebug::readProtectedAndPrivate()}. */
struct PropertyAccessorDebugVisibilityPair {
    string $prot;
    string $priv;
}

/**
 * Exhaustive property-hook matrix for the PHP &lt; 8.4 {@see Concerns\UsesPropertyAccessors} /
 * {@see PropertyAccessor} polyfill (and parity with PHP 8.4 native hooks).
 *
 * Expected polyfill `backed` / PHPDoc tag is noted on each property. Not for production use.
 */
class PropertyAccessorDebug
{
    // -------------------------------------------------------------------------
    // Separate storage used by virtual get+set pairs
    // -------------------------------------------------------------------------

    private string $_virtualName = 'seed';
    private int $_virtualCount = 0;
    private float $_celsius = 0.0;

    // -------------------------------------------------------------------------
    // VIRTUAL — no $this->{sameProp} in hooks, no default, no arrow-set
    // -------------------------------------------------------------------------

    /** Virtual get-only (arrow). backed: false → @property-read */
    public bool $virtualGetOnlyArrow {
        get => false;
    }

    /** Virtual get-only (block). backed: false → @property-read */
    public string $virtualGetOnlyBlock {
        get {
            return 'computed';
        }
    }

    /** Virtual set-only (no self-ref). backed: false → @property-write */
    public string $virtualSetOnly {
        set {
            // Side-effect only — does not touch $this->virtualSetOnly.
            $this->_virtualName = $value;
        }
    }

    /** Virtual get+set via separate field. backed: false → @property */
    public string $virtualName {
        get {
            return $this->_virtualName;
        }
        set(string $value) {
            $this->_virtualName = $value;
        }
    }

    /** Virtual derived (fahrenheit from celsius). backed: false → @property */
    public float $fahrenheit {
        get => ($this->_celsius * 9.0 / 5.0) + 32.0;
        set(float $value) {
            $this->_celsius = ($value - 32.0) * 5.0 / 9.0;
        }
    }

    /** Virtual get that calls a method. backed: false → @property-read */
    public string $virtualViaMethod {
        get => $this->computeLabel();
    }

    // -------------------------------------------------------------------------
    // BACKED — default value, $this->{prop} self-ref, and/or arrow set =>
    // -------------------------------------------------------------------------

    /** Backed get+set (block), self-ref, no default. backed: true → @property */
    public int $backedBothBlock {
        get {
            return $this->backedBothBlock;
        }
        set {
            $this->backedBothBlock = $value;
        }
    }

    /** Backed get+set with default. backed: true → @property */
    public string $backedWithDefault = 'default value' {
        get {
            return $this->backedWithDefault;
        }
        set(string $value) {
            $this->backedWithDefault = \strtolower($value);
        }
    }

    /** Backed get-only (self-ref); omitted set = default write. backed: true → @property */
    public string $backedGetOnly = 'get-only-default' {
        get => $this->backedGetOnly;
    }

    /** Backed set-only (self-ref); omitted get = default read. backed: true → @property */
    public string $backedSetOnly {
        set {
            $this->backedSetOnly = \strtoupper($value);
        }
    }

    /** Arrow set without self-ref still writes storage. backed: true → @property */
    public string $backedArrowSetOnly {
        set => \strtolower($value);
    }

    /** Arrow get + arrow set. backed: true → @property */
    public string $backedArrowBoth = 'arrow' {
        get => $this->backedArrowBoth;
        set => \strtolower($value);
    }

    /** Arrow get + block set. backed: true → @property */
    public string $backedArrowGetBlockSet = 'mix' {
        get => $this->backedArrowGetBlockSet;
        set {
            $this->backedArrowGetBlockSet = \trim($value);
        }
    }

    /** Block get + arrow set. backed: true → @property */
    public string $backedBlockGetArrowSet = 'mix2' {
        get {
            return $this->backedBlockGetArrowSet;
        }
        set => \strtoupper($value);
    }

    /** Typed set parameter (same as property type). backed: true → @property */
    public string $backedTypedSetParam = '' {
        get => $this->backedTypedSetParam;
        set(string $value) {
            $this->backedTypedSetParam = $value;
        }
    }

    /** Wider set parameter type (contravariant). backed: true → @property */
    public string $backedWiderSetParam = '' {
        get => $this->backedWiderSetParam;
        set(string|\Stringable $value) {
            $this->backedWiderSetParam = (string)$value;
        }
    }

    /** Compound assign against self in set. backed: true → @property */
    public int $backedCompoundAssign = 0 {
        get => $this->backedCompoundAssign;
        set {
            $this->backedCompoundAssign += $value;
        }
    }

    /** Get transforms backing; set writes raw. backed: true → @property */
    public string $backedGetTransforms = 'raw' {
        get => \strtoupper($this->backedGetTransforms);
        set {
            $this->backedGetTransforms = $value;
        }
    }

    /** Nullable backed. backed: true → @property */
    public ?string $backedNullable = null {
        get => $this->backedNullable;
        set {
            $this->backedNullable = $value;
        }
    }

    /** Union-typed backed. backed: true → @property */
    public int|string $backedUnion = 0 {
        get => $this->backedUnion;
        set {
            $this->backedUnion = $value;
        }
    }

    /** Uninitialized backed (no default) — first get should error until set. backed: true → @property */
    public string $backedUninitialized {
        get => $this->backedUninitialized;
        set {
            $this->backedUninitialized = $value;
        }
    }

    /** Classic “modified” flag pattern from PHP docs. backed: true → @property */
    private bool $modified = false;

    public string $backedModifiedPattern = 'default value' {
        get {
            if ($this->modified) {
                return $this->backedModifiedPattern . ' (modified)';
            }

            return $this->backedModifiedPattern;
        }
        set(string $value) {
            $this->backedModifiedPattern = \strtolower($value);
            $this->modified = true;
        }
    }

    // -------------------------------------------------------------------------
    // Visibility / asymmetric set
    // -------------------------------------------------------------------------

    /** public private(set). backed: true → @property */
    public private(set) string $asymPrivateSet = 'private-set' {
        get => $this->asymPrivateSet;
        set => $value;
    }

    /** public protected(set). backed: true → @property */
    public protected(set) string $asymProtectedSet = 'protected-set' {
        get => $this->asymProtectedSet;
        set => $value;
    }

    /** Protected hooked property. backed: true → @property */
    protected string $protectedBacked = 'prot' {
        get => $this->protectedBacked;
        set {
            $this->protectedBacked = $value;
        }
    }

    /** Private hooked property. backed: true → @property */
    private string $privateBacked = 'priv' {
        get => $this->privateBacked;
        set {
            $this->privateBacked = $value;
        }
    }

    /** Final get hook (cannot be overridden in a child). backed: false → @property-read */
    public string $finalGetHook {
        final get => 'final-get';
    }

    /** Final set hook. backed: true → @property */
    public string $finalSetHook = 'final-set' {
        get => $this->finalSetHook;
        final set => \strtolower($value);
    }

    // -------------------------------------------------------------------------
    // Backed get (by-value). Native `&get` is PHP ≥ 8.4 only — Tyhp rejects it
    // when targeting older PHP (polyfill `__get` cannot return by reference).
    // -------------------------------------------------------------------------

    /** Backed get. backed: true → @property */
    public bool $backedRefGet = false {
        get => $this->backedRefGet;
    }

    // -------------------------------------------------------------------------
    // Interacting hooks / multiple properties
    // -------------------------------------------------------------------------

    /** Virtual counter paired with virtualName-style storage. backed: false → @property */
    public int $virtualCount {
        get => $this->_virtualCount;
        set(int $value) {
            $this->_virtualCount = $value < 0 ? 0 : $value;
        }
    }

    /** Reads another hooked property from get. backed: false → @property-read */
    public string $virtualReadsSibling {
        get => $this->virtualName . '#' . (string)$this->virtualCount;
    }

    // -------------------------------------------------------------------------
    // Helpers / smoke surface (call after construct to exercise paths)
    // -------------------------------------------------------------------------

    private function computeLabel(): string
    {
        return 'via-method';
    }

    public function touchAsymmetricFromInside(string $privateSet, string $protectedSet): void
    {
        $this->asymPrivateSet = $privateSet;
        $this->asymProtectedSet = $protectedSet;
    }

    public function touchProtectedAndPrivate(string $prot, string $priv): void
    {
        $this->protectedBacked = $prot;
        $this->privateBacked = $priv;
    }

    public function readProtectedAndPrivate(): PropertyAccessorDebugVisibilityPair
    {
        return new PropertyAccessorDebugVisibilityPair() with [
            prot => $this->protectedBacked,
            priv => $this->privateBacked,
        ];
    }

    /**
     * Best-effort smoke that hits get/set/isset across the matrix.
     * Callers should wrap expected Error cases (read-only virtual write, uninitialized get, …).
     */
    public function smokeHappyPath(): array
    {
        $this->virtualName = 'renamed';
        $this->fahrenheit = 212.0;
        $this->virtualCount = 3;
        $this->backedBothBlock = 10;
        $this->backedWithDefault = 'Hello';
        $this->backedGetOnly = 'written-via-default-set';
        $this->backedSetOnly = 'lower';
        $this->backedArrowSetOnly = 'ARROW';
        $this->backedArrowBoth = 'Both';
        $this->backedArrowGetBlockSet = '  trim me  ';
        $this->backedBlockGetArrowSet = 'upper';
        $this->backedTypedSetParam = 'typed';
        $this->backedWiderSetParam = 'wider';
        $this->backedCompoundAssign = 5;
        $this->backedGetTransforms = 'abc';
        $this->backedNullable = 'n';
        $this->backedUnion = 'u';
        $this->backedUninitialized = 'now-init';
        $this->backedModifiedPattern = 'Changed';
        $this->finalSetHook = 'FINAL';
        $this->backedRefGet = true;
        $this->virtualSetOnly = 'side-effect';

        return [
            'virtualGetOnlyArrow' => $this->virtualGetOnlyArrow,
            'virtualGetOnlyBlock' => $this->virtualGetOnlyBlock,
            'virtualName' => $this->virtualName,
            'fahrenheit' => $this->fahrenheit,
            'virtualViaMethod' => $this->virtualViaMethod,
            'virtualCount' => $this->virtualCount,
            'virtualReadsSibling' => $this->virtualReadsSibling,
            'backedBothBlock' => $this->backedBothBlock,
            'backedWithDefault' => $this->backedWithDefault,
            'backedGetOnly' => $this->backedGetOnly,
            'backedSetOnly' => $this->backedSetOnly,
            'backedArrowSetOnly' => $this->backedArrowSetOnly,
            'backedArrowBoth' => $this->backedArrowBoth,
            'backedArrowGetBlockSet' => $this->backedArrowGetBlockSet,
            'backedBlockGetArrowSet' => $this->backedBlockGetArrowSet,
            'backedTypedSetParam' => $this->backedTypedSetParam,
            'backedWiderSetParam' => $this->backedWiderSetParam,
            'backedCompoundAssign' => $this->backedCompoundAssign,
            'backedGetTransforms' => $this->backedGetTransforms,
            'backedNullable' => $this->backedNullable,
            'backedUnion' => $this->backedUnion,
            'backedUninitialized' => $this->backedUninitialized,
            'backedModifiedPattern' => $this->backedModifiedPattern,
            'asymPrivateSet' => $this->asymPrivateSet,
            'asymProtectedSet' => $this->asymProtectedSet,
            'finalGetHook' => $this->finalGetHook,
            'finalSetHook' => $this->finalSetHook,
            'backedRefGet' => $this->backedRefGet,
            'isset_virtualName' => isset($this->virtualName),
            'isset_backedNullable' => isset($this->backedNullable),
        ];
    }
}

/**
 * Constructor property promotion + asymmetric set + wider set type.
 */
class PropertyAccessorDebugPromoted
{
    /** Non-promoted virtual on a class that also uses promotion. backed: false → @property-read */
    public string $alsoVirtualGetOnly {
        get => 'always';
    }

    public function __construct(
        public private(set) string $promotedPrivateSet {
            get => $this->promotedPrivateSet;
            set => \strtolower($value);
        },
        public string $promotedBackedBoth = 'promoted-default' {
            get => $this->promotedBackedBoth;
            set(string $value) {
                $this->promotedBackedBoth = $value;
            }
        },
        public \DateTimeInterface $promotedWiderSet = new \DateTimeImmutable('@0') {
            set(string|\DateTimeInterface $value) {
                if (\is_string($value)) {
                    $value = new \DateTimeImmutable($value);
                }
                $this->promotedWiderSet = $value;
            }
        },
    ): void {
    }

    public function rewritePrivateSet(string $value): void
    {
        $this->promotedPrivateSet = $value;
    }
}

/**
 * Generic host: free type-param property (synthetic set check) + hooked generic property.
 */
class PropertyAccessorDebugGeneric<TValue>
{
    /** Free generic property — polyfill synthetic set check. backed: true → @property */
    public TValue $freeGeneric;

    /** Hooked property whose type is the type param. backed: true → @property */
    public TValue $hookedGeneric {
        get => $this->hookedGeneric;
        set {
            $this->hookedGeneric = $value;
        }
    }

    /** Virtual wrapper around freeGeneric. backed: false → @property-read */
    public TValue $virtualOfGeneric {
        get => $this->freeGeneric;
    }

    public function __construct(TValue $freeGeneric, TValue $hookedGeneric): void
    {
        $this->freeGeneric = $freeGeneric;
        $this->hookedGeneric = $hookedGeneric;
    }
}

/**
 * Inheritance: plain parent properties, child adds / overrides hooks via parent::$prop::get/set.
 */
class PropertyAccessorDebugPoint
{
    public int $x = 0;
    public int $y = 0;

    public string $label = 'point';
}

class PropertyAccessorDebugPositivePoint extends PropertyAccessorDebugPoint
{
    /** Child set-only override; uses parent storage. */
    public int $x {
        set {
            if ($value < 0) {
                throw new \InvalidArgumentException('Too small');
            }
            parent::$x::set($value);
        }
    }

    /** Child get override of plain parent property. */
    public string $label {
        get => \strtoupper(parent::$label::get());
    }
}

class PropertyAccessorDebugHookedParent
{
    public string $name = 'parent' {
        get => $this->name;
        set => \strtolower($value);
    }
}

class PropertyAccessorDebugHookedChild extends PropertyAccessorDebugHookedParent
{
    /** Override get only; keep parent set via parent::$name::set when writing through default? */
    public string $name {
        get => \strtoupper(parent::$name::get());
        set {
            parent::$name::set($value);
        }
    }
}

/**
 * Class that already owns magic methods — exercises piece-trait / tyhpTry* merge path.
 */
class PropertyAccessorDebugWithOwnMagic
{
    public string $hooked = 'h' {
        get => $this->hooked;
        set {
            $this->hooked = $value;
        }
    }

    public function __get(string $name): mixed
    {
        if ($name === 'legacy') {
            return 'legacy-value';
        }

        \trigger_error(
            \sprintf('Undefined property: %s::$%s', static::class, $name),
            \E_USER_WARNING,
        );

        return null;
    }

    public function __set(string $name, mixed $value): void
    {
        if ($name === 'legacy') {
            return;
        }

        \trigger_error(
            \sprintf('Undefined property: %s::$%s', static::class, $name),
            \E_USER_WARNING,
        );
    }

    public function __isset(string $name): bool
    {
        return $name === 'legacy';
    }

    public function __unset(string $name): void
    {
        if ($name === 'legacy') {
            return;
        }
    }
}
