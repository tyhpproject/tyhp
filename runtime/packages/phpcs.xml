<?xml version="1.0"?>
<ruleset name="Tyhp Runtime Packages">
    <description>PHPCS rules for Tyhp-emitted PHP across runtime packages.</description>

    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <!-- Show sniff names, progress, and parallelize -->
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <!-- Emitted PHP under dist/tyhp-<pkg>/<version>/src -->
    <file>dist</file>

    <!-- Skip non-source / generated metadata / dependencies -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tyhp_src/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/tyhp-build-state\.json</exclude-pattern>

    <!--
      Target coding standard for emitted PHP.

      Exclusions cover intentional Tyhp compiler conventions that conflict with PSR-1/PSR-2 naming:
      - Generic factories / init hooks: new_*__tyhpGeneric, *__tyhpGeneric, __initGenerics__tyhpGeneric
      - Internal runtime fields: $__tyhp*, $__reflectedClass__tyhpGeneric
      - Async primitives: Promise::_async / ::_await

      Property hooks (PHP 8.4+) are still incomplete in PHPCS tokenizer/sniffs (see
      PHPCSStandards/PHP_CodeSniffer#731). Valid emit such as multiline hooks,
      `parent::$prop::get()`, `&get`, and hooks on promoted ctor params currently trip:
      - PropertyDeclaration.SpacingAfterType / Multiple / ScopeMissing / Underscore
      - ScopeIndent (control flow inside hooks)
      - OperatorSpacing on `&get` (PHP requires no space)
      - ReturnTypeDeclaration (crashes / false positives on ctor params with hooks)
      - MultiLineFunctionDeclaration.Indent (hook bodies inside promoted params nest deeper)
      Exclude those until PHPCS understands property hooks; keep emitting PSR-12-shaped hooks.
    -->
    <rule ref="PSR12">
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps"/>
        <exclude name="PSR2.Classes.PropertyDeclaration.Underscore"/>
        <exclude name="PSR2.Classes.PropertyDeclaration.Multiple"/>
        <exclude name="PSR2.Classes.PropertyDeclaration.ScopeMissing"/>
        <exclude name="PSR2.Classes.PropertyDeclaration.SpacingAfterType"/>
        <exclude name="PSR2.Methods.MethodDeclaration.Underscore"/>
        <exclude name="Generic.Files.LineLength.TooLong"/>
        <exclude name="Generic.WhiteSpace.ScopeIndent"/>
        <exclude name="PSR12.Operators.OperatorSpacing"/>
        <exclude name="PSR12.Functions.ReturnTypeDeclaration"/>
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration.Indent"/>
    </rule>
</ruleset>
