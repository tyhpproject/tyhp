// ---------------------------------------------------------------------------
// Language constructs — Story 14.5 Phase 3 (hand-curated; not from reflection)
//
// `exit` / `die` / `clone` are PHP reserved keywords (lexer T_EXIT / T_CLONE).
// Grammar keeps keyword call forms; these stubs supply signatures for binder /
// checker (arity, named args, FCC / callable identity). Userland
// `function exit` / `function die` / `function clone` cannot parse because
// `functionName` accepts only T_STRING | T_READONLY — matching PHP reserved
// behavior without a separate redeclaration rule.
//
// Gating: Story 20.5 (`declare(php=…)` / `#[\Tyhp\Php]`) is not available yet.
// Stubs are always present. Emit rewrites for clone-with / FCC on older
// `output.phpVersion` land in Story 14.5 Phase 5 (not gated here).
// ---------------------------------------------------------------------------

/**
 * Output a message and terminate the current script
 *
 * @param string|int $status If `$status` is a string, this is the message to print.
 *     If `$status` is an int, that value will be used as the exit status code.
 * @return never
 *
 * @link https://www.php.net/manual/function.exit.php
 */
function exit(string|int $status = 0): never;

/**
 * Equivalent to `exit`
 *
 * @param string|int $status If `$status` is a string, this is the message to print.
 *     If `$status` is an int, that value will be used as the exit status code.
 * @return never
 *
 * @link https://www.php.net/manual/function.die.php
 */
function die(string|int $status = 0): never;

/**
 * Create a copy of an object, optionally overriding properties (PHP 8.5 clone-with)
 *
 * Unary `clone $object` remains a grammar expression; this signature covers
 * call forms `clone($object)` / `clone($object, $withProperties)` and FCC
 * `clone(...)`.
 *
 * @param object $object The object to clone.
 * @param array $withProperties Property name => value overrides (clone-with).
 * @return object A clone of `$object` with overrides applied when provided.
 *
 * @link https://www.php.net/manual/function.clone.php
 */
function clone(object $object, array $withProperties = []): object;

