{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tyhp",
  "scopeName": "source.tyhp",
  "fileTypes": ["tyhp", "tyhpdef"],
  "patterns": [
    { "include": "#tyhp-open-tag" },
    { "include": "#tyhp-tagless-root" },
    { "include": "#inline-html" }
  ],
  "repository": {
    "tyhp-open-tag": {
      "begin": "(^\\s*)(<\\?)(tyhpdef|tyhp)\\b",
      "beginCaptures": {
        "2": { "name": "punctuation.section.embedded.begin.tyhp" },
        "3": { "name": "entity.name.tag.tyhp" }
      },
      "end": "(\\?>)",
      "endCaptures": {
        "1": { "name": "punctuation.section.embedded.end.tyhp" }
      },
      "contentName": "meta.embedded.block.tyhp",
      "patterns": [
        { "include": "#tyhp-code-body" }
      ]
    },
    "tyhp-tagless-root": {
      "name": "meta.embedded.block.tyhp",
      "begin": "\\A(?!\\s*<\\?(tyhpdef|tyhp|php)\\b)",
      "end": "\\z",
      "patterns": [
        { "include": "#tyhp-code-body" }
      ]
    },
    "inline-html": {
      "match": "[\\s\\S]"
    },
    "tyhp-code-body": {
      "patterns": [
        { "include": "source.tyhp.php#comment" },
        { "include": "source.tyhp.php#attribute" },
        { "include": "#use-extension" },
        { "include": "#struct-declaration" },
        { "include": "#extension-declaration" },
        { "include": "#type-alias" },
        { "include": "#operator-overload" },
        { "include": "source.tyhp.php#php-closure" },
        { "include": "#fn-declaration" },
        { "include": "#function-declaration" },
        { "include": "#class-declaration" },
        { "include": "#interface-declaration" },
        { "include": "#trait-declaration" },
        { "include": "#enum-declaration" },
        { "include": "#tyhp-string-double-quoted" },
        { "include": "source.tyhp.php#string-single-quoted" },
        { "include": "source.tyhp.php#string-heredoc" },
        { "include": "source.tyhp.php#string-nowdoc" },
        { "include": "source.tyhp.php#string-backtick" },
        { "include": "source.tyhp.php#number" },
        { "include": "source.tyhp.php#cast" },
        { "include": "#cast-decimal" },
        { "include": "source.tyhp.php#magic-constant" },
        { "include": "#using-assignment" },
        { "include": "#typeof-expression" },
        { "include": "#nameof-expression" },
        { "include": "#keyword-tyhp" },
        { "include": "source.tyhp.php#keyword-modifier" },
        { "include": "source.tyhp.php#keyword-control" },
        { "include": "source.tyhp.php#php-namespace-declaration" },
        { "include": "source.tyhp.php#keyword-declaration" },
        { "include": "#tyhp-anonymous-class" },
        { "include": "source.tyhp.php#new-expression" },
        { "include": "#tyhp-generic-in-code" },
        { "include": "#instanceof-expression" },
        { "include": "source.tyhp.php#keyword-other" },
        { "include": "source.tyhp.php#nullable-type" },
        { "include": "source.tyhp.php#this-variable" },
        { "include": "source.tyhp.php#variable" },
        { "include": "#tyhp-member-generic-method-call" },
        { "include": "source.tyhp.php#member-access" },
        { "include": "#tyhp-static-generic-method-call" },
        { "include": "source.tyhp.php#static-access" },
        { "include": "source.tyhp.php#class-reference-static" },
        { "include": "source.tyhp.php#operator" },
        { "include": "source.tyhp.php#function-call" },
        { "include": "source.tyhp.php#type-hint-class" },
        { "include": "source.tyhp.php#namespace-function-call" },
        { "include": "source.tyhp.php#namespace-name" },
        { "include": "#code-block" },
        { "include": "source.tyhp.php#punctuation" },
        { "include": "source.tyhp.php#named-argument" },
        { "include": "source.tyhp.php#identifier" }
      ]
    },
    "type-expression": {
      "patterns": [
        {
          "match": "\\?(?=[a-zA-Z_\\\\])",
          "name": "keyword.operator.nullable.php"
        },
        {
          "begin": "\\b((?i:array|callable|iterable))\\s*(<)",
          "beginCaptures": {
            "1": { "name": "keyword.other.type.php" },
            "2": { "name": "punctuation.definition.generic.begin.tyhp" }
          },
          "end": "(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.generic.end.tyhp" }
          },
          "name": "meta.generic-type.tyhp",
          "patterns": [
            { "include": "#type-expression" },
            { "match": ",", "name": "punctuation.separator.type.tyhp" }
          ]
        },
        {
          "begin": "(\\\\)([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*(?:\\\\[a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*)*)\\s*(<)",
          "beginCaptures": {
            "1": { "name": "punctuation.separator.inheritance.php" },
            "2": { "name": "support.class.tyhp" },
            "3": { "name": "punctuation.definition.generic.begin.tyhp" }
          },
          "end": "(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.generic.end.tyhp" }
          },
          "name": "meta.generic-type.tyhp",
          "patterns": [
            { "include": "#type-expression" },
            { "match": ",", "name": "punctuation.separator.type.tyhp" }
          ]
        },
        {
          "begin": "\\b([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*)\\s*(<)",
          "beginCaptures": {
            "1": { "name": "support.class.tyhp" },
            "2": { "name": "punctuation.definition.generic.begin.tyhp" }
          },
          "end": "(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.generic.end.tyhp" }
          },
          "name": "meta.generic-type.tyhp",
          "patterns": [
            { "include": "#type-expression" },
            { "match": ",", "name": "punctuation.separator.type.tyhp" }
          ]
        },
        {
          "match": "\\b(?i:int|float|string|bool|void|never|mixed|object|callable|array|iterable|null|self|static|parent|true|false|decimal|resource)\\b",
          "name": "keyword.other.type.php"
        },
        {
          "match": "(\\\\)([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*(?:\\\\[a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*)*)",
          "captures": {
            "1": { "name": "punctuation.separator.inheritance.php" },
            "2": { "name": "support.class.tyhp" }
          }
        },
        {
          "match": "\\b[a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*\\b",
          "name": "support.class.tyhp"
        },
        {
          "match": "\\|",
          "name": "punctuation.separator.type.union.tyhp"
        },
        {
          "match": "&(?!\\s*\\$)",
          "name": "punctuation.separator.type.intersection.tyhp"
        },
        {
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            { "include": "#type-expression" }
          ]
        }
      ]
    },
    "generic-type-arguments": {
      "begin": "(<)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.generic.begin.tyhp" }
      },
      "end": "(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.generic.end.tyhp" }
      },
      "name": "meta.generic-type-arguments.tyhp",
      "patterns": [
        {
          "begin": "\\b([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*)\\s+((?i:extends))\\b",
          "beginCaptures": {
            "1": { "name": "entity.name.type.parameter.tyhp" },
            "2": { "name": "storage.modifier.extends.php" }
          },
          "end": "(?=[,>])",
          "patterns": [
            { "include": "#type-expression" }
          ]
        },
        {
          "match": ",",
          "name": "punctuation.separator.type.tyhp"
        },
        {
          "match": "\\b[a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*\\b",
          "name": "entity.name.type.parameter.tyhp"
        }
      ]
    },
    "return-type": {
      "begin": "(\\:)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.return-type.tyhp" }
      },
      "end": "(?=[{;,)>]|\\b(?i:extends|implements|use)\\b)",
      "patterns": [
        {
          "begin": "(\\b(?i:parent)\\b)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "keyword.other.type.php" },
            "2": { "name": "punctuation.definition.arguments.begin.tyhp" }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": { "name": "punctuation.definition.arguments.end.tyhp" }
          },
          "patterns": [
            { "include": "source.tyhp.php#variable" },
            { "include": "source.tyhp.php#string-single-quoted" },
            { "include": "source.tyhp.php#string-double-quoted" },
            { "include": "source.tyhp.php#number" },
            { "include": "source.tyhp.php#comment" },
            { "match": ",", "name": "punctuation.separator.delimiter.tyhp" }
          ]
        },
        {
          "match": "\\b(?i:void)\\b",
          "name": "keyword.other.type.php"
        },
        { "include": "#type-expression" },
        { "include": "source.tyhp.php#comment" }
      ]
    },
    "parameter-list": {
      "begin": "(\\()",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.parameters.begin.tyhp" }
      },
      "end": "(\\))",
      "endCaptures": {
        "1": { "name": "punctuation.definition.parameters.end.tyhp" }
      },
      "patterns": [
        { "include": "source.tyhp.php#comment" },
        { "include": "source.tyhp.php#attribute" },
        { "include": "source.tyhp.php#keyword-modifier" },
        {
          "match": "\\b(?i:extends)\\b",
          "name": "storage.modifier.extends.php"
        },
        { "include": "#type-expression" },
        { "include": "source.tyhp.php#variable" },
        { "include": "source.tyhp.php#operator" },
        { "include": "source.tyhp.php#string-single-quoted" },
        { "include": "source.tyhp.php#string-double-quoted" },
        { "include": "source.tyhp.php#number" },
        {
          "match": "\\.\\.\\.",
          "name": "keyword.operator.spread.php"
        },
        {
          "match": "&",
          "name": "storage.modifier.reference.php"
        },
        {
          "match": ",",
          "name": "punctuation.separator.delimiter.tyhp"
        }
      ]
    },
    "function-declaration": {
      "begin": "(?:(?i:\\b(async)\\s+)?(?i:\\b(function)\\s+)(&\\s*)?([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*)\\s*)",
      "beginCaptures": {
        "1": { "name": "storage.modifier.async.tyhp" },
        "2": { "name": "storage.type.function.php" },
        "3": { "name": "storage.modifier.reference.php" },
        "4": { "name": "entity.name.function.tyhp" }
      },
      "end": "(?<=\\})|(?=;)",
      "name": "meta.function.tyhp",
      "patterns": [
        { "include": "#generic-type-arguments" },
        { "include": "#parameter-list" },
        { "include": "#return-type" },
        { "include": "#code-block" },
        { "include": "source.tyhp.php#comment" }
      ]
    },
    "fn-declaration": {
      "begin": "(?:(?i:\\b(async)\\s+)?(?i:\\b(fn)\\s+)(&\\s*)?([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*))",
      "beginCaptures": {
        "1": { "name": "storage.modifier.async.tyhp" },
        "2": { "name": "storage.type.function.php" },
        "3": { "name": "storage.modifier.reference.php" },
        "4": { "name": "entity.name.function.tyhp" }
      },
      "end": ";",
      "endCaptures": {
        "0": { "name": "punctuation.terminator.statement.php" }
      },
      "name": "meta.function.short.tyhp",
      "patterns": [
        { "include": "#generic-type-arguments" },
        { "include": "#parameter-list" },
        { "include": "#fn-return-type" },
        { "include": "#fn-body" }
      ]
    },
    "fn-body": {
      "begin": "(=>)",
      "beginCaptures": {
        "1": { "name": "keyword.operator.arrow.tyhp" }
      },
      "end": "(?=;)",
      "patterns": [
        { "include": "#tyhp-code-body" }
      ]
    },
    "tyhp-anonymous-class": {
      "begin": "(\\b(?i:new)\\b)\\s+(\\b(?i:class)\\b)",
      "beginCaptures": {
        "1": { "name": "keyword.other.new.php" },
        "2": { "name": "storage.type.class.php" }
      },
      "end": "(?<=\\})",
      "name": "meta.class.anonymous.tyhp",
      "patterns": [
        {
          "begin": "\\(",
          "beginCaptures": { "0": { "name": "punctuation.definition.arguments.begin.php" } },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.definition.arguments.end.php" } },
          "patterns": [
            { "include": "#tyhp-code-body" }
          ]
        },
        { "include": "source.tyhp.php#keyword-other" },
        { "include": "#type-expression" },
        { "include": "#class-body" },
        { "include": "source.tyhp.php#comment" }
      ]
    },
    "fn-return-type": {
      "begin": "(\\:)",
      "beginCaptures": {
        "1": { "name": "keyword.operator.return-value.php" }
      },
      "end": "(?==>)",
      "patterns": [
        { "include": "#type-expression" },
        { "include": "source.tyhp.php#comment" }
      ]
    },
    "class-declaration": {
      "begin": "(?i:\\b(class)\\s+([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*))",
      "beginCaptures": {
        "1": { "name": "storage.type.class.php" },
        "2": { "name": "entity.name.type.class.tyhp" }
      },
      "end": "(?<=\\})",
      "name": "meta.class.tyhp",
      "patterns": [
        { "include": "#generic-type-arguments" },
        { "include": "source.tyhp.php#keyword-other" },
        { "include": "#type-expression" },
        { "include": "#class-body" },
        { "include": "source.tyhp.php#comment" }
      ]
    },
    "interface-declaration": {
      "begin": "(?i:\\b(interface)\\s+([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*))",
      "beginCaptures": {
        "1": { "name": "storage.type.interface.php" },
        "2": { "name": "entity.name.type.interface.tyhp" }
      },
      "end": "(?<=\\})",
      "name": "meta.interface.tyhp",
      "patterns": [
        { "include": "#generic-type-arguments" },
        { "include": "source.tyhp.php#keyword-other" },
        { "include": "#type-expression" },
        { "include": "#class-body" },
        { "include": "source.tyhp.php#comment" }
      ]
    },
    "trait-declaration": {
      "begin": "(?i:\\b(trait)\\s+([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*))",
      "beginCaptures": {
        "1": { "name": "storage.type.trait.php" },
        "2": { "name": "entity.name.type.trait.tyhp" }
      },
      "end": "(?<=\\})",
      "name": "meta.trait.tyhp",
      "patterns": [
        { "include": "#generic-type-arguments" },
        { "include": "source.tyhp.php#keyword-other" },
        { "include": "#type-expression" },
        { "include": "#class-body" },
        { "include": "source.tyhp.php#comment" }
      ]
    },
    "enum-declaration": {
      "begin": "(?i:\\b(enum)\\s+([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*))",
      "beginCaptures": {
        "1": { "name": "storage.type.enum.php" },
        "2": { "name": "entity.name.type.enum.tyhp" }
      },
      "end": "(?<=\\})",
      "name": "meta.enum.tyhp",
      "patterns": [
        { "include": "#generic-type-arguments" },
        { "include": "#return-type" },
        { "include": "source.tyhp.php#keyword-other" },
        { "include": "#type-expression" },
        { "include": "#class-body" },
        { "include": "source.tyhp.php#comment" }
      ]
    },
    "struct-declaration": {
      "begin": "(?i:\\b(struct)\\s+([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*))",
      "beginCaptures": {
        "1": { "name": "storage.type.struct.tyhp" },
        "2": { "name": "entity.name.type.struct.tyhp" }
      },
      "end": "(?<=\\})",
      "name": "meta.struct.tyhp",
      "patterns": [
        { "include": "#generic-type-arguments" },
        {
          "match": "\\b(?i:extends)\\b",
          "name": "storage.modifier.extends.php"
        },
        { "include": "#type-expression" },
        { "include": "#class-body" },
        { "include": "source.tyhp.php#comment" }
      ]
    },
    "use-extension": {
      "begin": "(?i:\\b(use)\\s+(extension)\\b)",
      "beginCaptures": {
        "1": { "name": "keyword.other.use.php" },
        "2": { "name": "storage.type.extension.tyhp" }
      },
      "end": "(?<=\\})|;",
      "name": "meta.use-extension.tyhp",
      "patterns": [
        { "include": "source.tyhp.php#comment" },
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.block.begin.tyhp" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.block.end.tyhp" }
          },
          "patterns": [
            { "include": "source.tyhp.php#comment" },
            {
              "match": "\\b(?i:as)\\b",
              "name": "keyword.other.as.php"
            },
            {
              "match": "\\b(?i:insteadof)\\b",
              "name": "keyword.other.insteadof.php"
            },
            {
              "match": ";",
              "name": "punctuation.terminator.statement.php"
            },
            {
              "match": ",",
              "name": "punctuation.separator.delimiter.tyhp"
            },
            {
              "match": "\\b[a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*\\b",
              "name": "entity.name.function.tyhp"
            }
          ]
        },
        {
          "match": "(\\\\)([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*(?:\\\\[a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*)*)",
          "captures": {
            "1": { "name": "punctuation.separator.inheritance.php" },
            "2": { "name": "entity.name.type.extension.tyhp" }
          }
        },
        {
          "match": "\\b[a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*\\b",
          "name": "entity.name.type.extension.tyhp"
        }
      ]
    },
    "extension-declaration": {
      "begin": "(?i:\\b(extension)\\s+(?!(?i:function|fn|operator)\\b)([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*))",
      "beginCaptures": {
        "1": { "name": "storage.type.extension.tyhp" },
        "2": { "name": "entity.name.type.extension.tyhp" }
      },
      "end": "(?<=\\})",
      "name": "meta.extension.tyhp",
      "patterns": [
        { "include": "#generic-type-arguments" },
        {
          "match": "\\b(?i:extends)\\b",
          "name": "storage.modifier.extends.php"
        },
        { "include": "#type-expression" },
        { "include": "#class-body" },
        { "include": "source.tyhp.php#comment" }
      ]
    },
    "type-alias": {
      "begin": "(?i:\\b(type)\\s+([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*))",
      "beginCaptures": {
        "1": { "name": "storage.type.type-alias.tyhp" },
        "2": { "name": "entity.name.type.alias.tyhp" }
      },
      "end": ";",
      "name": "meta.type-alias.tyhp",
      "patterns": [
        { "include": "#generic-type-arguments" },
        { "include": "#tyhp-string-double-quoted" },
        { "include": "source.tyhp.php#string-single-quoted" },
        { "include": "#type-expression" },
        {
          "match": "=",
          "name": "keyword.operator.assignment.tyhp"
        },
        { "include": "source.tyhp.php#comment" }
      ]
    },
    "operator-overload": {
      "begin": "(?:(?i:\\b(abstract|final)\\s+)?(?i:\\b(operator)\\s+)(\\*\\*|\\+\\+|--|===|!==|<=>|<=|>=|<<|>>|==|!=|\\+|-|\\*|/|%|~|!|\\.|<|&|\\^|\\||(?i:true|false|empty|null|convert)))",
      "beginCaptures": {
        "1": { "name": "storage.modifier.php" },
        "2": { "name": "storage.type.operator.tyhp" },
        "3": { "name": "entity.name.function.operator.tyhp" }
      },
      "end": "(?<=\\})|(?<=;)",
      "name": "meta.operator-overload.tyhp",
      "patterns": [
        { "include": "#generic-type-arguments" },
        { "include": "#parameter-list" },
        { "include": "#return-type" },
        { "include": "#code-block" },
        { "include": "source.tyhp.php#comment" }
      ]
    },
    "class-body": {
      "begin": "(\\{)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.class.body.begin.tyhp" }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": { "name": "punctuation.definition.class.body.end.tyhp" }
      },
      "patterns": [
        { "include": "#tyhp-class-member" }
      ]
    },
    "tyhp-class-member": {
      "patterns": [
        { "include": "source.tyhp.php#attribute" },
        { "include": "source.tyhp.php#comment" },
        { "include": "#use-extension" },
        { "include": "source.tyhp.php#keyword-modifier" },
        { "include": "#typeof-expression" },
        { "include": "#nameof-expression" },
        { "include": "#operator-overload" },
        { "include": "#type-alias" },
        { "include": "#keyword-tyhp" },
        { "include": "#fn-declaration" },
        { "include": "#function-declaration" },
        { "include": "#tyhp-anonymous-class" },
        { "include": "source.tyhp.php#new-expression" },
        { "include": "source.tyhp.php#class-reference-static" },
        { "include": "#tyhp-member-generic-method-call" },
        { "include": "source.tyhp.php#member-access" },
        { "include": "#tyhp-static-generic-method-call" },
        { "include": "source.tyhp.php#static-access" },
        { "include": "source.tyhp.php#function-call" },
        { "include": "source.tyhp.php#keyword-control" },
        { "include": "#instanceof-expression" },
        { "include": "source.tyhp.php#keyword-other" },
        { "include": "#type-expression" },
        { "include": "source.tyhp.php#this-variable" },
        { "include": "source.tyhp.php#variable" },
        { "include": "#tyhp-code-body" }
      ]
    },
    "code-block": {
      "begin": "(\\{)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.block.begin.tyhp" }
      },
      "end": "(\\})",
      "endCaptures": {
        "1": { "name": "punctuation.definition.block.end.tyhp" }
      },
      "patterns": [
        { "include": "#tyhp-code-body" }
      ]
    },
    "instanceof-expression": {
      "match": "(\\b(?i:instanceof)\\b)\\s+((?:\\\\)?[a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*(?:\\\\[a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*)*)",
      "captures": {
        "1": { "name": "keyword.operator.type.php" },
        "2": {
          "patterns": [
            { "include": "#type-expression" }
          ]
        }
      }
    },
    "typeof-expression": {
      "begin": "(\\b(?i:typeof)\\b)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.operator.typeof.tyhp" },
        "2": { "name": "punctuation.section.parens.begin.php" }
      },
      "end": "(\\))",
      "endCaptures": {
        "1": { "name": "punctuation.section.parens.end.php" }
      },
      "patterns": [
        { "include": "#type-expression" }
      ]
    },
    "nameof-expression": {
      "begin": "(\\b(?i:nameof)\\b)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.operator.nameof.tyhp" },
        "2": { "name": "punctuation.section.parens.begin.php" }
      },
      "end": "(\\))",
      "endCaptures": {
        "1": { "name": "punctuation.section.parens.end.php" }
      },
      "patterns": [
        { "include": "#type-expression" }
      ]
    },
    "keyword-tyhp": {
      "patterns": [
        {
          "match": "\\b(?i:async|await)\\b",
          "name": "keyword.control.async.tyhp"
        },
        {
          "match": "\\b(?i:struct)\\b",
          "name": "storage.type.struct.tyhp"
        },
        {
          "match": "\\b(?i:extension)\\b",
          "name": "storage.type.extension.tyhp"
        },
        {
          "match": "\\b(?i:type)\\b",
          "name": "storage.type.type-alias.tyhp"
        },
        {
          "match": "\\b(?i:operator)\\b",
          "name": "storage.type.operator.tyhp"
        },
        {
          "match": "\\b(?i:using)\\b",
          "name": "keyword.control.using.tyhp"
        },
        {
          "match": "\\b(?i:with)\\b",
          "name": "keyword.operator.with.tyhp"
        },
        {
          "match": "\\b(?i:is_an|is_a|isan|isa|is)\\b",
          "name": "keyword.operator.type.tyhp"
        },
        {
          "match": "\\b(?i:typeof)\\b",
          "name": "keyword.operator.typeof.tyhp"
        },
        {
          "match": "\\b(?i:nameof)\\b",
          "name": "keyword.operator.nameof.tyhp"
        },
        {
          "match": "\\b(?i:variable_exists)\\b",
          "name": "keyword.other.variable-exists.tyhp"
        },
        {
          "match": "\\b(?i:deprecated)\\b",
          "name": "storage.modifier.deprecated.tyhp"
        },
        {
          "match": "\\b(?i:obsolete)\\b",
          "name": "storage.modifier.obsolete.tyhp"
        },
        {
          "match": "\\b(?i:void|parent)\\b",
          "name": "keyword.other.type.php"
        },
        {
          "match": "\\b(?i:decimal|resource)\\b",
          "name": "keyword.other.type.php"
        }
      ]
    },
    "tyhp-generic-in-code": {
      "patterns": [
        {
          "begin": "\\b((?i:array|callable|iterable))(<)",
          "beginCaptures": {
            "1": { "name": "keyword.other.type.php" },
            "2": { "name": "punctuation.definition.generic.begin.tyhp" }
          },
          "end": "(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.generic.end.tyhp" }
          },
          "name": "meta.generic-type.tyhp",
          "patterns": [
            { "include": "#type-expression" },
            { "match": ",", "name": "punctuation.separator.type.tyhp" }
          ]
        },
        {
          "begin": "\\b([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*)(<)",
          "beginCaptures": {
            "1": { "name": "support.class.tyhp" },
            "2": { "name": "punctuation.definition.generic.begin.tyhp" }
          },
          "end": "(>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.generic.end.tyhp" }
          },
          "name": "meta.generic-type.tyhp",
          "patterns": [
            { "include": "#type-expression" },
            { "match": ",", "name": "punctuation.separator.type.tyhp" }
          ]
        }
      ]
    },
    "tyhp-static-generic-method-call": {
      "begin": "(::)([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*)(<)",
      "beginCaptures": {
        "1": { "name": "keyword.operator.class.php" },
        "2": { "name": "entity.name.function.tyhp" },
        "3": { "name": "punctuation.definition.generic.begin.tyhp" }
      },
      "end": "(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.generic.end.tyhp" }
      },
      "patterns": [
        { "include": "#type-expression" },
        { "match": ",", "name": "punctuation.separator.type.tyhp" }
      ]
    },
    "tyhp-member-generic-method-call": {
      "begin": "(->|\\?->)([a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*)(<)",
      "beginCaptures": {
        "1": { "name": "keyword.operator.class.php" },
        "2": { "name": "entity.name.function.tyhp" },
        "3": { "name": "punctuation.definition.generic.begin.tyhp" }
      },
      "end": "(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.generic.end.tyhp" }
      },
      "patterns": [
        { "include": "#type-expression" },
        { "match": ",", "name": "punctuation.separator.type.tyhp" }
      ]
    },
    "cast-decimal": {
      "match": "\\(\\s*(?i:decimal)\\s*\\)",
      "name": "keyword.operator.type.cast.tyhp"
    },
    "using-assignment": {
      "match": "(:=)",
      "name": "keyword.operator.assignment.using.tyhp"
    },
    "tyhp-string-double-quoted": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.php",
      "patterns": [
        {
          "begin": "(\\$\\{)(?=[^$])",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.interpolation.begin.tyhp" }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": { "name": "punctuation.definition.interpolation.end.tyhp" }
          },
          "contentName": "meta.interpolation.tyhp",
          "patterns": [
            { "include": "#typeof-expression" },
            { "include": "#nameof-expression" },
            {
              "match": "\\b(?i:int|float|string|bool|array|object|callable|iterable|mixed|void|null|never|self|static|parent|decimal|resource|struct)\\b",
              "name": "keyword.other.type.php"
            },
            {
              "match": "\\b[a-zA-Z_\\x80-\\xff][a-zA-Z0-9_\\x80-\\xff]*\\b",
              "name": "support.class.tyhp"
            },
            {
              "match": "[+|&]",
              "name": "keyword.operator.quantifier.tyhp"
            },
            {
              "match": "\\?",
              "name": "keyword.operator.nullable.php"
            }
          ]
        },
        { "include": "source.tyhp.php#string-escape" },
        { "include": "source.tyhp.php#string-interpolation" }
      ]
    }
  }
}
