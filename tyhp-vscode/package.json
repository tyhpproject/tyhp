{
    "name": "tyhp-language",
    "displayName": "Tyhp Language",
    "description": "Syntax highlighting for the Tyhp programming language (.tyhp, .tyhpdef) and PHP (Tyhp) grammar",
    "version": "0.2.1",
    "publisher": "tyhp-lang",
    "engines": {
        "vscode": "^1.70.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "tyhp",
                "aliases": [
                    "Tyhp",
                    "tyhp"
                ],
                "extensions": [
                    ".tyhp",
                    ".tyhpdef"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "php-tyhp",
                "aliases": [
                    "PHP (Tyhp)"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "tyhp",
                "scopeName": "source.tyhp",
                "path": "./syntaxes/tyhp.tmLanguage.json"
            },
            {
                "language": "php-tyhp",
                "scopeName": "source.tyhp.php",
                "path": "./syntaxes/tyhp-php.tmLanguage.json"
            },
            {
                "scopeName": "markdown.tyhp.codeblock",
                "path": "./syntaxes/tyhp-markdown.tmLanguage.json",
                "injectTo": ["text.html.markdown"],
                "embeddedLanguages": {
                    "meta.embedded.block.tyhp": "tyhp",
                    "meta.embedded.block.php-tyhp": "php-tyhp"
                }
            }
        ]
    }
}
