<?tyhp

namespace TestData\Parser;

function runControlFlow(int $value): string
{
    if ($value < 0) {
        return 'negative';
    } else if ($value === 0) {
        return 'zero';
    }

    for ($i = 0; $i < $value; $i++) {
        if ($i > 10) {
            break;
        }
    }

    foreach ([1, 2, 3] as $item) {
        if ($item === 2) {
            continue;
        }
    }

    while ($value > 0) {
        $value--;
    }

    switch ($value) {
        case 0:
            return 'done';
        default:
            return 'other';
    }
}
