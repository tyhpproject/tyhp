{
  "suite": "story22.1/docblocks",
  "description": "Generated PHPStan/Psalm docblocks for lossy declarations",
  "defaults": {
    "action": "build"
  },
  "cases": [
    {
      "id": "generics_param",
      "file": "generics.tyhp",
      "expect": {
        "errorCount": 0,
        "php": "expected/App/Generics/_functions.php"
      }
    },
    {
      "id": "generics_template",
      "file": "generics.tyhp",
      "expect": {
        "errorCount": 0,
        "php": "expected/App/Generics/Box.php"
      }
