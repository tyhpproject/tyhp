      "expect": {
        "errorCount": 0,
        "php": "expected/App/Generics/IntBox.php"
      }
    },
    {
      "id": "generics_implements",
      "file": "generics.tyhp",
      "expect": {
        "errorCount": 0,
        "php": "expected/App/Generics/UserStore.php"
      }
