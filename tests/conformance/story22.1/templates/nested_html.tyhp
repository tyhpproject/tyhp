<?tyhp
declare(strict_types=1);
namespace App\Nested;

function render(string $title, bool $show, array<string> $items): void {
    ?>
    <h1><?= $title ?></h1>
    <?tyhp
    if ($show) {
        ?>
        <p>shown</p>
        <?tyhp
    }
    foreach ($items as string $item) {
        ?>
        <li><?= $item ?></li>
        <?tyhp
    }
    $write = function() use ($title): void {
        ?>
        <footer><?= $title ?></footer>
        <?tyhp
    };
    $write();
    ?>
    <p><?= $title, $title ?></p>
    <?tyhp
}

function main(): void {
    render("Ada", true, ["a", "b"]);
}

main();
