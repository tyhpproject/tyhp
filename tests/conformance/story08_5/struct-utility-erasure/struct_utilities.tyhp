<?tyhp
declare(strict_types=1);
namespace App;

type Point = struct {
    int $x = 0;
    string $y = '';
};

function takeStructKey(__StructKey<Point> $k): string {
    return $k;
}

function takeProps(__Properties<Point> $p): array {
    return $p;
}

function takeReturn(__CallableReturnType<callable(string): int> $r): int {
    return $r;
}

function takeParams(__CallableParametersTuple<callable(string): int> $p): array {
    return $p;
}

function takeStructDef(__StructDef<__StructRecord<Point, '$x'|'$y', int|string>> $s): array {
    return $s;
}

function demo(): void {
    __StructKey<Point> $key = '$x';
    __Properties<Point> $props = ['x' => 1];
    __CallableReturnType<callable(string): int> $ret = 1;
    string $plain = $key;
    takeStructKey('$x');
    takeProps(['x' => 1]);
    takeProps([]);
    takeReturn(1);
}
