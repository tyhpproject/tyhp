      "config": { "output:phpVersion": "8.4" },
      "expect": {
        "errorCount": 0,
        "php": "expected/php84/App/Widget.php"
      }
    },
    {
      "id": "php84_extension",
      "file": "file_gated_extension.tyhp",
      "config": { "output:phpVersion": "8.4" },
      "expect": {
        "errorCount": 0,
        "php": "expected/php84/App/GatedStringOps.php"
      }
    },
    {
      "id": "php85_functions",
      "file": "matrix.tyhp",
      "config": { "output:phpVersion": "8.5" },
      "expect": {
        "errorCount": 0,
        "php": "expected/php85/App/_functions.php"
      }
    },
    {
      "id": "php85_widget",
      "file": "matrix.tyhp",
      "config": { "output:phpVersion": "8.5" },
