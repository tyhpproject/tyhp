      "config": { "output:phpVersion": "8.5" },
      "expect": {
        "errorCount": 0,
        "php": "expected/php85/App/GatedStringOps.php"
      }
    },
    {
      "id": "php85_file_gated",
      "file": "file_gated.tyhp",
      "config": { "output:phpVersion": "8.5" },
      "expect": {
        "errorCount": 0,
        "php": "expected/php85/App/Gated/_functions.php"
      }
    }
  ]
}
