    {
      "id": "file_level_active_php85",
      "file": "file_level_inactive.tyhp",
      "config": { "phpVersion": "8.5" },
      "expect": { "errorCount": 0 }
    },
    {
      "id": "nested_unsatisfiable_4302",
      "file": "nested_unsatisfiable.tyhp",
      "config": { "phpVersion": "8.4" },
      "expect": {
        "errorCount": { "min": 1 },
        "codes": [4302]
      }
    },
    {
      "id": "overlap_4303",
      "file": "overlap.tyhp",
      "config": { "phpVersion": "8.4" },
      "expect": {
        "errorCount": { "min": 1 },
