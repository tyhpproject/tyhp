      "expect": {
        "errorCount": { "min": 1 },
        "codes": [4304]
      }
    },
    {
      "id": "invalid_constraint_4300",
      "file": "invalid_constraint.tyhp",
      "expect": {
        "errorCount": { "min": 1 },
        "codes": [4300]
      }
    },
    {
      "id": "mixed_declare_4301",
      "file": "mixed_declare.tyhp",
      "expect": {
        "errorCount": { "min": 1 },
        "codes": [4301]
