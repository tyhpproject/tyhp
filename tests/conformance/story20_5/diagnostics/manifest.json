{
  "suite": "story20_5/diagnostics",
  "description": "Story 20.5 — PHP version-gate diagnostics (4300–4306) and sibling-alternate lint",
  "defaults": {
    "action": "lint",
    "config": {
      "phpVersion": "8.2"
    }
  },
  "cases": [
    {
      "id": "happy_path_php84",
      "file": "happy_path.tyhp",
      "config": { "phpVersion": "8.4" },
      "expect": { "errorCount": 0 }
    },
    {
      "id": "happy_path_php82_omits_gated",
      "file": "happy_path.tyhp",
      "expect": { "errorCount": 0 }
    },
    {
      "id": "alternate_variants_php82",
      "file": "alternate_variants.tyhp",
      "config": { "phpVersion": "8.2" },
      "expect": { "errorCount": 0 }
    },
    {
      "id": "alternate_variants_php83",
      "file": "alternate_variants.tyhp",
      "config": { "phpVersion": "8.3" },
      "expect": { "errorCount": 0 }
    },
    {
      "id": "alternate_variants_php84",
      "file": "alternate_variants.tyhp",
      "config": { "phpVersion": "8.4" },
      "expect": { "errorCount": 0 }
