<?tyhp
declare(strict_types=1);
namespace App;

function bareExit(): void
{
    exit;
}

function bareDie(): void
{
    die;
}

function exitPositional(): void
{
    exit(0);
}

function diePositional(): void
{
    die(1);
}

function exitEmpty(): void
{
    exit();
}

function dieEmpty(): void
{
    die();
}

function exitNamed(): void
{
    exit(status: 0);
}

function dieNamed(): void
{
    die(status: 1);
}

function exitFcc(): void
{
    $fn = exit(...);
    $fn(0);
}

function dieFcc(): void
{
    $fn = die(...);
    $fn(1);
}
