<?tyhp
declare(strict_types=1);
namespace App\Lower;

function wrap(string $s): string
{
    return "[" . $s . "]";
}

function shout(string $s): string
{
    return $s . "!";
}

function pipeFcc(string $s): string
{
    return $s |> wrap(...);
}

function pipeChain(string $s): string
{
    return $s
        |> wrap(...)
        |> shout(...);
}

function pipeArrow(string $s): string
{
    return $s |> (fn(string $x): string => wrap($x));
}

function pipeVariableCallable(string $s): mixed
{
    $f = (fn(string $x): string => wrap($x));
    return $s |> $f;
}

function pipeArrowThenFcc(string $s): string
{
    return $s
        |> (fn(string $x): string => shout($x))
        |> wrap(...);
}

function identity(int $n): int
{
    return $n;
}

function pipePrecedenceLeft(): int
{
    return 5 + 2 |> identity(...);
}
